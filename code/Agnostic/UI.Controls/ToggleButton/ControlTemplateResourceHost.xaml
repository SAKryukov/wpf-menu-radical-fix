<agnostic:ResourceHost x:Class="SA.Agnostic.UI.Controls.ControlTemplateResourceHost"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:agnostic="clr-namespace:SA.Agnostic.UI.Markup;assembly=Agnostic.UI">

    <agnostic:ResourceHost.Resources>

        <ControlTemplate x:Key="{x:Type ControlTemplate}" TargetType="{x:Type ToggleButton}">
            <Grid Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" VerticalAlignment="{Binding Path=VerticalAlignmentBox, RelativeSource={RelativeSource TemplatedParent}}">
                    <TextBlock x:Name="HeightAnchor" Text=" " SnapsToDevicePixels="True" Visibility="Hidden" />
                    <ContentPresenter
                        Height="{Binding ElementName=HeightAnchor, Path=ActualHeight}"
                        Content="{Binding Viewbox, RelativeSource={RelativeSource TemplatedParent}}"/>
                </Grid>
                <TextBlock Grid.Column="1" Text=" " SnapsToDevicePixels="True" Visibility="Hidden" />
                <ContentPresenter Grid.Column="2" x:Name="contentPresenter" Margin="0" VerticalAlignment="{Binding Path=VerticalAlignmentBox, RelativeSource={RelativeSource TemplatedParent}}"/>
            </Grid>
        </ControlTemplate>

    </agnostic:ResourceHost.Resources>

</agnostic:ResourceHost>
